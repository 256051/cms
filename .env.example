# Copy to .env and supply your own secrets. For local HTTP testing only, use Development.
CMS_ENVIRONMENT=Production
DB_TYPE=PostgreSQL
DB_PASSWORD=replace-with-your-database-password
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=cms;Username=cms;Password=replace-with-your-database-password
SETUP_USERNAME=your-admin-name
SETUP_PASSWORD=replace-with-at-least-12-characters
SITE_URL=https://cms.example.com
CMS_BIND_ADDRESS=127.0.0.1
CMS_PORT=8088
CONSUL_ENABLED=false
CONSUL_ADDRESS=http://consul:8500
CONSUL_KEY=cms/config
CONSUL_TOKEN=
