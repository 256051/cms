FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY . .
RUN dotnet restore src/Cms.Api/Cms.Api.csproj --locked-mode && dotnet publish src/Cms.Api/Cms.Api.csproj -c Release --no-restore -o /out
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
RUN mkdir -p /data/uploads /data/keys && chown -R app:app /data
ENV Urls=http://0.0.0.0:8080 Storage__Path=/data/uploads Security__KeyPath=/data/keys
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "Cms.Api.dll"]
