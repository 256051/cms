# Copy to .env. Supply your own passwords; no default administrator is included.
COMPOSE_PROJECT_NAME=itmao-cms
CMS_ENVIRONMENT=Production
DB_TYPE=Sqlite
DB_CONNECTION_STRING=Data Source=/data/cms.db
SETUP_USERNAME=
SETUP_PASSWORD=
SITE_URL=https://itmao.club
CMS_BIND_ADDRESS=0.0.0.0
CMS_PORT=80
TLS_DIRECTORY=./tls
CMS_NETWORK_SUBNET=172.30.46.0/24
CONSUL_ENABLED=false
CONSUL_ADDRESS=http://consul:8500
CONSUL_KEY=cms/config
CONSUL_TOKEN=
